{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Next.js: dev",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Ready in"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "focus": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Next.js: ブラウザで開く",
      "type": "shell",
      "command": "open 'http://127.0.0.1:3001'",
      "windows": {
        "command": "start http://127.0.0.1:3001"
      },
      "linux": {
        "command": "xdg-open http://127.0.0.1:3001"
      },
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    }
  ]
}
