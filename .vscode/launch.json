{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: dev（起動後にブラウザを開く）",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Ready in",
        "uriFormat": "http://127.0.0.1:3001",
        "action": "openExternally"
      }
    }
  ]
}
