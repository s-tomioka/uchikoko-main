# このファイルをコピーして .env.local を作成し、値を設定してください。
# cp .env.example .env.local

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Vercel Blob — https://vercel.com/docs/storage/vercel-blob
# Vercel ダッシュボード > Storage > Blob で作成したトークンを設定
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# 注文通知の送付先（ショップオーナーのメールアドレス）
SHOP_EMAIL=shop@example.com

# 送信元アドレス
# 開発時: onboarding@resend.dev（Resend共有ドメイン、そのまま使用可）
# 本番時: Resendダッシュボードでドメイン認証後に変更する
RESEND_FROM_EMAIL=注文受付 <onboarding@resend.dev>

# 写真ダウンロードURLの署名シークレット（openssl rand -hex 32 で生成）
PHOTO_DOWNLOAD_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# アプリのベースURL（ダウンロードリンクの絶対URL生成に使用）
# 開発時: http://localhost:3000
# 本番時: https://your-domain.com
# ※ Vercelデプロイ時は VERCEL_URL が自動設定されるため省略可（本番カスタムドメインは明示的に設定）
APP_URL=http://localhost:3001
